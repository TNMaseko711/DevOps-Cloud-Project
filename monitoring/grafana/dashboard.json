{
  "title": "E-Commerce Platform Overview",
  "timezone": "browser",
  "panels": [
    {
      "title": "Request Rate",
      "type": "timeseries",
      "targets": [{ "expr": "rate(http_requests_total[5m])" }]
    },
    {
      "title": "P95 Latency",
      "type": "timeseries",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))" }]
    },
    {
      "title": "Pod Restarts",
      "type": "timeseries",
      "targets": [{ "expr": "sum(kube_pod_container_status_restarts_total) by (pod)" }]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
